<Window x:Class="App.Windows.WindowPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pick a table window" Height="540" Width="720" MinHeight="400" MinWidth="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource Caption}" Margin="0,0,0,12"
                   Text="Open a table in your poker client, then select it here. A rule is created from its program, window class and title."/>

        <DataGrid Grid.Row="1" x:Name="WindowsDataGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="None"
                  MouseDoubleClick="WindowsDataGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Window title" Binding="{Binding Title}" Width="*"/>
                <DataGridTextColumn Header="Program" Binding="{Binding ProcessName}" Width="130"/>
                <DataGridTextColumn Header="Class" Binding="{Binding ClassName}" Width="200"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Margin="0,14,0,0">
            <CheckBox x:Name="ChkMatchProgram" IsChecked="True">
                <TextBlock x:Name="TxtSelectedProgram" Text="Match the program" TextTrimming="CharacterEllipsis"/>
            </CheckBox>
            <CheckBox x:Name="ChkMatchClass" IsChecked="True" Margin="0,4,0,0">
                <TextBlock x:Name="TxtSelectedClass" Text="Match the window class" TextTrimming="CharacterEllipsis"/>
            </CheckBox>
            <CheckBox x:Name="ChkMatchTitle" Margin="0,4,0,0">
                <TextBlock x:Name="TxtSelectedTitle" Text="Match the window title" TextTrimming="CharacterEllipsis"/>
            </CheckBox>
            <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                       Text="Program and class usually identify every window of one poker client, lobby included. Edit the rule afterwards to add a title part that only tables have. Matching the whole title tends to match this one table only."/>
        </StackPanel>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Button x:Name="BtnRefresh" Content="Refresh list" MinWidth="100" HorizontalAlignment="Left" Click="BtnRefresh_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnOk" Content="Add rule" MinWidth="100" Margin="0,0,8,0" Click="BtnOk_Click" IsDefault="True" IsEnabled="False"
                        Style="{DynamicResource AccentButtonStyle}"/>
                <Button x:Name="BtnCancel" Content="Cancel" MinWidth="80" Click="BtnCancel_Click" IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
