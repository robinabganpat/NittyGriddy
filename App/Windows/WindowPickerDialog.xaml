<Window x:Class="App.Windows.WindowPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Window to Filter" Height="500" Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Select a window to add to filters:" FontSize="14" Margin="0,0,0,10"/>

        <DataGrid Grid.Row="1" x:Name="WindowsDataGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  MouseDoubleClick="WindowsDataGrid_MouseDoubleClick"
                  Margin="0,0,0,10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Window Title" Binding="{Binding Title}" Width="*"/>
                <DataGridTextColumn Header="Class Name" Binding="{Binding ClassName}" Width="200"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Vertical" Margin="0,0,0,10">
            <TextBlock Text="Selected window details:" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBlock x:Name="TxtSelectedTitle" Text="Title: " Margin="0,0,0,3"/>
            <TextBlock x:Name="TxtSelectedClass" Text="Class: " Margin="0,0,0,3"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnRefresh" Content="Refresh List" Width="100" Height="30" Margin="0,0,10,0" Click="BtnRefresh_Click"/>
            <Button x:Name="BtnOk" Content="OK" Width="80" Height="30" Margin="0,0,10,0" Click="BtnOk_Click" IsDefault="True"/>
            <Button x:Name="BtnCancel" Content="Cancel" Width="80" Height="30" Click="BtnCancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
