<UserControl x:Class="App.Views.HotkeysPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,14,0">

            <TextBlock Style="{StaticResource Caption}" Margin="2,0,0,12"
                       Text="Hotkeys work in any program. Click a box and press the keys; Backspace clears it. Table hotkeys are only held while the grid is on, so they do not get in the way when you are not playing. Slot numbers are the numbers shown on the grid."/>

            <ItemsControl x:Name="GroupList" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource CardTitle}"/>
                                <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="280"/>
                                                    <ColumnDefinition Width="170"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Label}" Style="{StaticResource Body}"/>
                                                <controls:HotkeyBox Grid.Column="1" Gesture="{Binding Gesture}"
                                                                    GotKeyboardFocus="HotkeyBox_GotKeyboardFocus"
                                                                    LostKeyboardFocus="HotkeyBox_LostKeyboardFocus"/>
                                                <Button Grid.Column="2" Content="Clear" Margin="8,0,0,0" Click="BtnClear_Click"
                                                        IsEnabled="{Binding IsSet}"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Note}" Margin="12,0,0,0" VerticalAlignment="Center"
                                                           Style="{StaticResource Caption}" Foreground="{StaticResource WarningBrush}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Content="Reset all to defaults" HorizontalAlignment="Left" Margin="0,0,0,12" Click="BtnReset_Click"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
