<Window x:Class="App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:App.Views"
        Title="NittyGriddy" Height="780" Width="1020" MinHeight="560" MinWidth="900"
        Icon="icon.ico"
        FontSize="14"
        UseLayoutRounding="True">
    <Grid Margin="20,16,6,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header: grid state on the left, actions and profile on the right -->
        <Grid Grid.Row="0" Margin="0,0,14,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <CheckBox x:Name="SwGrid" Grid.Column="0" Style="{StaticResource ToggleSwitch}" Click="SwGrid_Click"
                      VerticalAlignment="Center" HorizontalAlignment="Left"
                      ToolTip="Turn table management on or off">
                <StackPanel>
                    <TextBlock x:Name="TxtGridState" Text="Grid is off" FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <TextBlock x:Name="TxtGridSummary" Style="{StaticResource Caption}" Text=""/>
                </StackPanel>
            </CheckBox>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnArrange" Content="Arrange tables" Margin="0,0,8,0" Click="BtnArrange_Click"
                        Style="{DynamicResource AccentButtonStyle}"
                        ToolTip="Place every table in a slot, filling the grid from slot 1"/>
                <Button x:Name="BtnToFront" Content="Tables to front" Margin="0,0,8,0" Click="BtnToFront_Click"
                        ToolTip="Bring every table above other windows (Alt+0 by default). Nothing is moved."/>
                <Button x:Name="BtnPreview" Content="Show grid" Margin="0,0,24,0" Click="BtnPreview_Click"
                        ToolTip="Show the slots on screen while you adjust the layout"/>

                <TextBlock Text="Profile" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="CmbProfile" Width="170" SelectionChanged="CmbProfile_SelectionChanged"/>
                <Button x:Name="BtnProfileMenu" Content="⋯" Width="36" Padding="0" Margin="6,0,0,0" Click="BtnProfileMenu_Click"
                        ToolTip="Add, rename, delete, import or export profiles">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="New profile…" Click="MenuNewProfile_Click"/>
                            <MenuItem Header="Duplicate this profile…" Click="MenuDuplicateProfile_Click"/>
                            <MenuItem Header="Rename…" Click="MenuRenameProfile_Click"/>
                            <MenuItem x:Name="MenuDeleteProfile" Header="Delete" Click="MenuDeleteProfile_Click"/>
                            <Separator/>
                            <MenuItem Header="Import from file…" Click="MenuImportProfile_Click"/>
                            <MenuItem Header="Export to file…" Click="MenuExportProfile_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </StackPanel>
        </Grid>

        <!-- First run only: the way from a fresh install to tables in slots that a hotkey reaches -->
        <views:SetupGuideView x:Name="Guide" Grid.Row="1" Visibility="Collapsed"/>

        <TabControl x:Name="Pages" Grid.Row="2" Style="{StaticResource PageTabs}" SelectionChanged="Pages_SelectionChanged">
            <TabItem Header="Layout">
                <views:LayoutPage x:Name="LayoutPage" Margin="0,16,0,0"/>
            </TabItem>
            <TabItem Header="Tables">
                <views:TablesPage x:Name="TablesPage" Margin="0,16,0,0"/>
            </TabItem>
            <TabItem Header="Hotkeys">
                <views:HotkeysPage x:Name="HotkeysPage" Margin="0,16,0,0"/>
            </TabItem>
            <TabItem Header="Behaviour">
                <views:BehaviorPage x:Name="BehaviorPage" Margin="0,16,0,0"/>
            </TabItem>
        </TabControl>

        <!-- Status line: outcome of the last action and anything that needs attention -->
        <Grid Grid.Row="3" Margin="0,8,14,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TxtStatus" Grid.Column="0" Style="{StaticResource Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="TxtHotkeyWarning" Grid.Column="1" Style="{StaticResource Caption}"
                       Foreground="{StaticResource WarningBrush}" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Window>
