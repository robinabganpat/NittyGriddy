<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Application styles layered on the built-in Fluent theme.
        Control looks (buttons, text boxes, sliders, ...) come from the theme; brushes are looked up
        dynamically so they follow it.
    -->

    <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

    <!-- Status colours that the theme does not supply -->
    <SolidColorBrush x:Key="GridOnBrush" Color="#3DDC84"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#F0B849"/>

    <!-- An empty and an occupied slot, as the monitor preview on the Layout page draws them -->
    <SolidColorBrush x:Key="SlotEmptyFillBrush" Color="#386495ED"/>
    <SolidColorBrush x:Key="SlotEmptyStrokeBrush" Color="#B06495ED"/>
    <SolidColorBrush x:Key="SlotTakenFillBrush" Color="#703DDC84"/>

    <!-- A titled panel grouping related settings -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="20,16"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <Style x:Key="CardTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <Style x:Key="Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Secondary explanatory text -->
    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        <Setter Property="Margin" Value="0,0,10,0"/>
    </Style>

    <!-- On/off switch, applied to a CheckBox -->
    <Style x:Key="ToggleSwitch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="48" Height="24" VerticalAlignment="Center">
                            <Border x:Name="Track"
                                    CornerRadius="12"
                                    Background="Transparent"
                                    BorderBrush="{DynamicResource TextFillColorSecondaryBrush}"
                                    BorderThickness="1.5"/>
                            <Ellipse x:Name="Thumb"
                                     Width="12" Height="12"
                                     HorizontalAlignment="Left"
                                     Margin="6,0,0,0"
                                     Fill="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </Grid>
                        <ContentPresenter VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource GridOnBrush}"/>
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource GridOnBrush}"/>
                            <Setter TargetName="Thumb" Property="Fill" Value="#10240F"/>
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Thumb" Property="Margin" Value="0,0,6,0"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Track" Property="BorderThickness" Value="2.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Page navigation. The theme's own tabs mark the selected page with a fill that is barely darker than the
        window, and the window backdrop takes its tint from the wallpaper, so that fill can disappear entirely.
        Here the selected page is marked by text brightness and an accent bar, which read on any backdrop.
    -->
    <Style x:Key="PageTab" TargetType="TabItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid Background="Transparent" Margin="0,0,4,0">
                        <Border x:Name="Back" CornerRadius="6" Margin="0,0,0,7" Background="Transparent"/>
                        <!-- Text properties are set on the label, not the TabItem: the page is the TabItem's child and would inherit them -->
                        <ContentPresenter x:Name="Label" ContentSource="Header" Margin="14,8,14,15" RecognizesAccessKey="True"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.FontSize="14" TextElement.FontWeight="SemiBold"
                                          TextElement.Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <Border x:Name="Mark" Height="3" CornerRadius="1.5" Margin="14,0" VerticalAlignment="Bottom"
                                Background="{DynamicResource AccentFillColorDefaultBrush}" Opacity="0"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="0.4"/>
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Back" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                            <Setter TargetName="Label" Property="TextElement.Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Label" Property="TextElement.Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Mark" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.12"/>
                                        <DoubleAnimation Storyboard.TargetName="Mark"
                                                         Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                         To="1" Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction>
                                                <ExponentialEase EasingMode="EaseOut" Exponent="5"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Mark" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.1"/>
                                        <DoubleAnimation Storyboard.TargetName="Mark"
                                                         Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                         To="0.4" Duration="0:0:0.1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Label" Property="TextElement.Foreground" Value="{DynamicResource TextFillColorDisabledBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PageTabs" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource PageTab}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid KeyboardNavigation.TabNavigation="Local">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <!-- The rule ends where the cards end; the bar of the selected page sits on it -->
                        <Border Grid.Row="0" Margin="0,0,14,0" BorderThickness="0,0,0,1"
                                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                            <StackPanel IsItemsHost="True" Orientation="Horizontal" Margin="-14,0,0,-1"
                                        KeyboardNavigation.TabIndex="1"/>
                        </Border>
                        <ContentPresenter Grid.Row="1" ContentSource="SelectedContent"
                                          KeyboardNavigation.TabIndex="2"
                                          KeyboardNavigation.TabNavigation="Local"
                                          KeyboardNavigation.DirectionalNavigation="Contained"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Small numbered tile identifying a slot -->
    <Style x:Key="SlotBadge" TargetType="Border">
        <Setter Property="MinWidth" Value="30"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="6,0"/>
    </Style>

</ResourceDictionary>
